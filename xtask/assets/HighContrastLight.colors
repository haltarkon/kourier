#
# A high-contrast light color scheme for `cargo xtask shots --matrix`: pure black on pure
# white, saturated focus and selection colors, the frame contrast at its maximum. Written for
# this project (the values are chosen here, nothing is copied from a color scheme package); it
# only has to look like what a person who needs high contrast would have chosen.

[ColorEffects:Disabled]
Color=128,128,128
ColorAmount=0.75
ColorEffect=2
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=false
Color=128,128,128
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=225,225,225
BackgroundNormal=255,255,255
DecorationFocus=128,0,255
DecorationHover=0,0,255
ForegroundActive=0,0,255
